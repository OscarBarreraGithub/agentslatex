{
  "name": "agentslatex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4390 --strictPort",
    "start": "vite preview --host 127.0.0.1 --port 4390 --strictPort",
    "build": "node scripts/prepare-template.mjs && tsc --noEmit && tsc -p tsconfig.worker.json && vite build",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup-assets.mjs && node scripts/prepare-fixtures.mjs",
    "test": "tsx --test tests/*.test.ts && node --test tests/project.test.mjs",
    "fixtures": "node scripts/prepare-fixtures.mjs",
    "build:hosted": "DEPLOY=1 VITE_COMPILER_BASE=/compiler/1.4.1-static1/ pnpm build && node scripts/static-compiler.mjs && node scripts/hosted-assets.mjs",
    "dev:hosted": "wrangler dev --ip 127.0.0.1 --port 4391"
  },
  "dependencies": {
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "^6.43.15",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/auth-oauth-app": "^9.0.5",
    "codemirror": "6.0.2",
    "fflate": "0.8.2",
    "markdown-it": "^15.0.3",
    "pdfjs-dist": "6.4.299",
    "texlyre-busytex": "1.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "24.10.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "^4.151.3"
  }
}
