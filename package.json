{
  "name": "agentslatex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4390 --strictPort",
    "start": "vite preview --host 127.0.0.1 --port 4390 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup-assets.mjs && node scripts/prepare-fixtures.mjs",
    "test": "node --test tests/project.test.mjs",
    "fixtures": "node scripts/prepare-fixtures.mjs"
  },
  "dependencies": {
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/theme-one-dark": "6.1.3",
    "codemirror": "6.0.2",
    "fflate": "0.8.2",
    "pdfjs-dist": "6.4.299",
    "texlyre-busytex": "1.4.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
